{
    "name": "fun-fp-js",
    "version": "0.2.1",
    "description": "즐거운 함수형 프로그래밍 — Static Land 명세를 따르는 타입 클래스 라이브러리. 의존성 0개, min+gzip 26KB.",
    "keywords": [
        "functional",
        "fp",
        "static-land",
        "typeclass",
        "monad",
        "optics",
        "lens",
        "maybe",
        "either",
        "task"
    ],
    "license": "MIT",
    "author": "loveqoo",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/loveqoo/fun-fp-js.git"
    },
    "homepage": "https://github.com/loveqoo/fun-fp-js#readme",
    "bugs": {
        "url": "https://github.com/loveqoo/fun-fp-js/issues"
    },
    "type": "module",
    "main": "./dist/fun-fp.cjs",
    "module": "./dist/fun-fp.js",
    "types": "./dist/fun-fp.d.ts",
    "exports": {
        ".": {
            "types": "./dist/fun-fp.d.ts",
            "import": "./dist/fun-fp.js",
            "require": "./dist/fun-fp.cjs",
            "default": "./dist/fun-fp.cjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "README.en.md",
        "LICENSE"
    ],
    "sideEffects": false,
    "scripts": {
        "test": "node tests/run.js",
        "prepublishOnly": "node tests/run.js",
        "baseline": "node tests/baseline-report.js",
        "build": "node build.js && node build-types.js",
        "build:js": "node build.js",
        "build:types": "node build-types.js",
        "typecheck": "tsc --noEmit"
    },
    "engines": {
        "node": ">=14"
    },
    "devDependencies": {
        "typescript": "^5.6.0"
    }
}
